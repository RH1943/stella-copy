{
  "compilerOptions": {
    "baseUrl": ".",
    "sourceMap": false,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "isolatedModules": true,
    "noEmit": true,
    "strictNullChecks": true,
    "lib": ["DOM", "ES5", "ES6", "ES7", "ES2018"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
